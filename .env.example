# Watchman API environment.
# Copy to .env for local development. Never commit the filled-in file.
# Replace every placeholder. Do not point local experiments at the production database.

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Paystack. Webhook signatures are HMAC-SHA512 of the raw body using the secret key.
# Paystack does not use a separate webhook secret. Leave the legacy variable unset.
PAYSTACK_SECRET_KEY=sk_live_or_sk_test
PAYSTACK_PUBLIC_KEY=pk_live_or_pk_test

# exchangerate-api.com key for USD→GHS. Checkout returns 503 when this is missing.
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
PRO_PRICE_USD=12

# Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Watchman <notifications@trywatchman.app>

# Shared secret sent as X-Cron-Secret to POST /api/cron/weekly-summary.
# Generate a long random value. It is not derived from the Supabase service key.
CRON_SECRET=generate_a_long_random_string

# Application
APP_ENV=development
DEBUG=false
# Comma-separated browser origins. Include every frontend you actually serve.
CORS_ORIGINS=http://localhost:3000,https://trywatchman.app,https://www.trywatchman.app,https://watchman.app,https://www.watchman.app

# Server
HOST=0.0.0.0
PORT=8000
